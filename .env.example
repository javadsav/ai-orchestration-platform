# --- Postgres ---
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator
POSTGRES_DB=orchestrator
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@postgres:5432/orchestrator
DATABASE_URL_SYNC=postgresql+psycopg://orchestrator:orchestrator@postgres:5432/orchestrator

# --- RabbitMQ ---
RABBITMQ_USER=orchestrator
RABBITMQ_PASSWORD=orchestrator
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://orchestrator:orchestrator@rabbitmq:5672//

# --- Redis (Celery result backend + WebSocket pub/sub transport) ---
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Used by Next.js server components (same Docker network)
API_BASE_URL=http://backend:8000
# Used by the browser directly (published ports on the host)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
